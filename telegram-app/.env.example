# Copia para .env.local em desenvolvimento (nunca comitar o .env.local real).
# Em produção estas variáveis vivem na Vercel (Project Settings → Environment Variables),
# não neste ficheiro.

# Bot do Telegram — token de @BotFather
TELEGRAM_BOT_TOKEN=

# Ligada automaticamente pela integração Neon<>Vercel quando o Postgres é criado
# a partir do separador Storage do projeto. Em desenvolvimento local, copia o
# valor de "POSTGRES_URL" das variáveis de ambiente da Vercel.
DATABASE_URL=

# URL pública onde esta app fica publicada (usada para construir o link da Mini App
# que o bot envia, e para validar o webhook). Ex.: https://sueca-telegram.vercel.app
PUBLIC_APP_URL=

# Segredo aleatório próprio (gera um com `openssl rand -hex 32`) usado para o
# Telegram confirmar que os pedidos ao webhook vêm mesmo dele
# (cabeçalho X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=
